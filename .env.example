# Local testing only: copy to .env, fill in, then: set -a; source .env; set +a; npm start
# On Railway, add these in the service's Variables tab instead (see LAUNCH.md).
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
# Payments: Stripe is used when STRIPE_SECRET_KEY is set; otherwise Razorpay.
# PAYMENT_PROVIDER=stripe|razorpay forces one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices by country live in src/pricing.js and are created in Stripe automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RZP_PLAN_SOLO=
RZP_PLAN_COUPLE=
RZP_PLAN_FAMILY=
ADMIN_TOKEN=pick-a-password
# Your final public address (https://rekha.io), used for canonical links, hreflang and the
# sitemap. Other hosts (railway.app, www) are then 301-redirected here, except /api/.
# Set it only once the domain opens. CANONICAL_REDIRECT=0 keeps the links but turns off the redirect.
PUBLIC_URL=
# Machine translation of missing strings and articles, a minute after each start. 0 = off.
TRANSLATE_AUTO=1
AI_MONTHLY_BUDGET_USD=30
# Optional: the app creates and stores a session secret if this is empty.
SESSION_SECRET=
# LOCAL ONLY. Never add DB_PATH in Railway: the app uses the attached volume by itself.
DB_PATH=./data/rekha.db
# Shows a test sign-in box locally. It is always off on Railway.
DEV_LOGIN=1
PORT=3000

# Optional: fixed web-push keys for daily alerts (otherwise created once and stored in the database).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional: IndexNow key (otherwise created once and stored), INDEXNOW=0 to switch pings off.
# INDEXNOW_KEY=
# Optional: public profile URLs for the Organization details, comma-separated.
# SOCIAL_LINKS=
# Optional: off-site nightly backup to S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3).
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=rekha-backups
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_REGION=auto
# Email through Resend (the key goes in Railway Variables only).
# RESEND_API_KEY=
# EMAIL_FROM=Rekha <hello@rekha.io>
# EMAIL_REPLY_TO=
# Analytics (optional): GA4 measurement ID and Microsoft Clarity project ID.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# CLARITY_PROJECT_ID=
