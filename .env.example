# Local testing only: copy to .env, fill in, then: set -a; source .env; set +a; npm start
# On Railway, add these in the service's Variables tab instead (see LAUNCH.md).
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
# Payments: Stripe is used when STRIPE_SECRET_KEY is set; otherwise Razorpay.
# PAYMENT_PROVIDER=stripe|razorpay forces one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices by country live in src/pricing.js and are created in Stripe automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RZP_PLAN_SOLO=
RZP_PLAN_COUPLE=
RZP_PLAN_FAMILY=
ADMIN_TOKEN=pick-a-password
# Your final public address (https://rekha.io), used for canonical links, hreflang and the
# sitemap. Other hosts (railway.app, www) are then 301-redirected here, except /api/.
# Set it only once the domain opens. CANONICAL_REDIRECT=0 keeps the links but turns off the redirect.
PUBLIC_URL=
# Machine translation of missing strings and articles, a minute after each start. 0 = off.
TRANSLATE_AUTO=1
AI_MONTHLY_BUDGET_USD=30
# Optional: the app creates and stores a session secret if this is empty.
SESSION_SECRET=
# LOCAL ONLY. Never add DB_PATH in Railway: the app uses the attached volume by itself.
DB_PATH=./data/rekha.db
# Shows a test sign-in box locally. It is always off on Railway.
DEV_LOGIN=1
PORT=3000
